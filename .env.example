# ========================================
# SERVER CONFIGURATION (Required for Prod)
# ========================================
DOMAIN_NAME=messenger.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
TURN_EXTERNAL_IP=203.0.113.1

# ========================================
# APPLICATION SETTINGS
# ========================================
APP_ENV=prod
HTTP_PORT=8080
HTTPS_PORT=8443
LOG_LEVEL=info
ENABLE_HTTPS=true
SCHEDULER_ENABLED=true
HYBRID_MODE=true
XMPP_SYNC_ENABLED=true

# ========================================
# CORS & WEBRTC
# ========================================
# Update this to match your DOMAIN_NAME
CORS_ORIGINS=https://messenger.yourdomain.com
# Use the same domain for TURN server
TURN_SERVER_URI=turn:messenger.yourdomain.com:3478?transport=tcp
# TURN_USERNAME=turnuser
# TURN_PASSWORD will be managed via secrets

# ========================================
# LIVEKIT (Cloud or Self-Hosted)
# ========================================
LIVEKIT_URL=wss://your-livekit-url
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET are managed via secrets

# ========================================
# PUSH NOTIFICATIONS (Firebase & VAPID)
# ========================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path inside the container:
FIREBASE_CREDENTIALS_PATH=/app/certs/firebase-service-account.json

# ========================================
# SMTP (Email Notifications)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Note: Passwords, Database URL, JWT Secrets, Encryption Master Key
# should be managed in the .secrets/ directory using scripts/generate-secrets.sh
