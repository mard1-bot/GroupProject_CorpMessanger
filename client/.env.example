# Client environment variables for Corp Messenger

# Backend URL (use your server IP or domain for production)
EXPO_PUBLIC_BACKEND_IP=your-server-ip-or-domain
EXPO_PUBLIC_BACKEND_PORT=8080

# For production with HTTPS, use port 443:
# EXPO_PUBLIC_BACKEND_PORT=443

# Expo Project ID (get from https://expo.dev)
EXPO_PROJECT_ID=your-expo-project-id-here

# TURN server configuration for WebRTC (for NAT traversal)
# These will be fetched from the backend API if not set
EXPO_PUBLIC_TURN_SERVER_URI=turn:your-server-ip:3478?transport=tcp
EXPO_PUBLIC_TURN_USERNAME=turnuser
EXPO_PUBLIC_TURN_PASSWORD=turnpass123

# Example for local development:
# EXPO_PUBLIC_BACKEND_IP=192.168.0.100
# EXPO_PUBLIC_BACKEND_PORT=8080

# Example for production:
# EXPO_PUBLIC_BACKEND_IP=messenger.yourdomain.com
# EXPO_PUBLIC_BACKEND_PORT=443
