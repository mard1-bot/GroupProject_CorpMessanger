# Application Environment
APP_ENV=local
HTTP_PORT=8080
HTTPS_PORT=8443
LOG_LEVEL=info
ENABLE_HTTPS=false
SCHEDULER_ENABLED=false

# Port for metrics/logging endpoints (optional, defaults to HTTP_PORT)
# METRICS_PORT=3000

# TLS/SSL Configuration for HTTPS
# Set to true to enable HTTPS (required for WebRTC in production)
TLS_ENABLED=false
# Path to TLS certificate file (full chain)
TLS_CERT_PATH=/app/certs/server.crt
# Path to TLS private key file
TLS_KEY_PATH=/app/certs/server.key
# For development, generate self-signed certificates:
# openssl req -x509 -newkey rsa:4096 -keyout certs/server.key -out certs/server.crt -days 365 -nodes

# Database Configuration
POSTGRES_DB=corpmessenger
POSTGRES_USER=corpmessenger
POSTGRES_PASSWORD=your-secure-password-here
DB_DSN=postgres://corpmessenger:your-secure-password-here@localhost:5432/corpmessenger?sslmode=disable
# Database SSL mode: disable, require, verify-ca, verify-full
# For production, use require or verify-full for secure database connections
DB_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=change-me-to-at-least-32-characters-long-secret-key

# Encryption master key for envelope encryption (AES-256-GCM)
# Generate a secure 32-byte key and encode it in base64:
# openssl rand -base64 32
# This is CRITICAL for security - private keys will be encrypted at rest using this key
ENCRYPTION_MASTER_KEY=your-base64-encoded-32-byte-master-key-here

# XMPP/ejabberd configuration (optional - for native XMPP support)
EJABBERD_HOST=localhost
EJABBERD_PORT=5222
EJABBERD_USERNAME=admin
EJABBERD_PASSWORD=your-ejabberd-password
EJABBERD_API_SECRET=your-ejabberd-api-secret
EJABBERD_ADMIN_USER=admin@localhost

# Hybrid mode configuration
HYBRID_MODE=true
XMPP_SYNC_ENABLED=true

# Storage Configuration (MinIO/S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=corpmessenger

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# Firebase Cloud Messaging for push notifications
FIREBASE_SERVER_KEY=your-firebase-server-key-here
# FCM HTTP v1 Configuration (recommended for production)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# TURN server configuration for WebRTC (required for production)
# Use coturn or similar TURN server for NAT traversal
TURN_SERVER_URI=turn:localhost:3478?transport=tcp
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpass123
TURN_EXTERNAL_IP=localhost

# LiveKit Configuration (for group calls and SFU)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret1234567890abcdef
